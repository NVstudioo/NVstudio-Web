0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75\"></path></svg></div><span class=\"font-black\" style=\"font-size:clamp(1.5rem, 3vw, 2.5rem);color:#a78bfa14\">02</span></div><h3 class=\"text-white font-bold mb-3\" style=\"font-size:clamp(1rem, 1.6vw, 1.2rem)\">Collaboration</h3><p class=\"text-white/45 leading-relaxed flex-1\" style=\"font-size:clamp(0.8rem, 1vw, 0.875rem)\">Our multi-team, multi-project structure drives shared success. We believe the best outcomes come from great teams working together.</p><div class=\"absolute bottom-0 left-0 h-[2px] w-0 group-hover:w-full transition-all duration-500 rounded-b-[20px]\" style=\"background:linear-gradient(to right, #a78bfa, transparent)\"></div></div></div><div style=\"opacity:0;transform:translateY(30px)\"><div class=\"service-card-v2 group h-full flex flex-col\" style=\"padding:clamp(1.5rem, 2.5vw, 2rem)\"><div class=\"flex items-start justify-between mb-6\"><div class=\"svc-icon-box\" style=\"background:rgba(52,211,153,0.08);border:1px solid rgba(52,211,153,0.2)\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"23 6 13.5 15.5 8.5 10.5 1 18\"></polyline><polyline points=\"17 6 23 6 23 12\"></polyline></svg></div><span class=\"font-black\" style=\"font-size:clamp(1.5rem, 3vw, 2.5rem);color:#34d39914\">03</span></div><h3 class=\"text-white font-bold mb-3\" style=\"font-size:clamp(1rem, 1.6vw, 1.2rem)\">Impact</h3><p class=\"text-white/45 leading-relaxed flex-1\" style=\"font-size:clamp(0.8rem, 1vw, 0.875rem)\">We build real products that solve real problems for real users. Every line of code, every design decision — it all matters.</p><div class=\"absolute bottom-0 left-0 h-[2px] w-0 group-hover:w-full transition-all duration-500 rounded-b-[20px]\" style=\"background:linear-gradient(to right, #34d399, transparent)\"></div></div></div></div></div></section></section><section class=\"\" style=\"opaci